msgstr "Zeit"

msgid "Time zone"
msgstr "Zeitzone"

msgid "Today and tomorrow"
msgstr "Heute und morgen"

msgid "Too many attempts. Please wait 15 minutes."
msgstr "Zu viele Versuche. Bitte warte 15 Minuten."

msgid "Too many registrations from your address. Please try again later."
msgstr ""
"Zu viele Registrierungen von deiner Adresse. Bitte versuch es später noch"
" einmal."

msgid "Try again"
msgstr "Nochmal versuchen"

msgid "Try it"
msgstr "Ausprobieren"

msgid "Try the live demo"
msgstr "Live-Demo ausprobieren"

msgid "Two-factor code"
msgstr "Zwei-Faktor-Code"

msgid "Undo"
msgstr "Rückgängig"

#, python-format
msgid "Up to %(d)s left (done around %(t)s)."
msgstr "Noch bis zu %(d)s (fertig gegen %(t)s)."

msgid "Use this plug"
msgstr "Diese Steckdose nutzen"

msgid "Usually both agree: cheap hours are windy and sunny."
msgstr "Meist passt beides: Günstige Stunden sind windig und sonnig."

msgid "Virtual plug"
msgstr "Virtuelle Steckdose"

msgid "Volts (V)"
msgstr "Volt (V)"

#, python-format
msgid "Waited %(d)s"
msgstr "%(d)s gewartet"

msgid "Waiting"
msgstr "Wartet"

msgid "Waiting for cheap power"
msgstr "Wartet auf günstigen Strom"

msgid "Waiting for cheap, green power"
msgstr "Wartet auf günstigen, grünen Strom"

msgid "Waiting for green power"
msgstr "Wartet auf Ökostrom"

msgid "Waiting for the best mix of green power and price"
msgstr "Wartet auf die beste Mischung aus Ökostrom und Preis"

#, python-format
msgid "Waiting for the best window %(start)s–%(end)s."
msgstr "Wartet auf das beste Zeitfenster %(start)s–%(end)s."

#, python-format
