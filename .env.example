# Copy to an env file on the server (mode 0600) for `docker run --env-file`, or export locally.
# Generate a data key with:  efficharge gen-key
EFFICHARGE_DATA_KEYS=k20261105:REPLACE_ME
# Session cookie signing key, e.g.: python -c 'import secrets; print(secrets.token_urlsafe(48))'
EFFICHARGE_SECRET_KEY=REPLACE_ME
EFFICHARGE_DATABASE_URL=sqlite+aiosqlite:////var/lib/efficharge/efficharge.db
EFFICHARGE_BIDDING_ZONE=DE-LU
EFFICHARGE_COUNTRY=de
EFFICHARGE_TIMEZONE=Europe/Berlin
EFFICHARGE_FETCH_INTERVAL_S=900
EFFICHARGE_POLL_INTERVAL_S=30
EFFICHARGE_COOKIE_SECURE=1
# the reverse proxy's address as the container sees it (its X-Forwarded-For is trusted)
EFFICHARGE_TRUSTED_PROXY=172.17.0.1
EFFICHARGE_REGISTRATION_OPEN=0
# no public demo, no registration: accounts only via `efficharge add-user`
EFFICHARGE_DEMO=0
# the public start page (/about, and / without a login); 0: / leads to the login page
EFFICHARGE_ABOUT_PAGE=0
# who sees /admin (registrations waiting, accounts): login emails, comma-separated
EFFICHARGE_ADMINS=you@example.org
# Impressum (§ 5 DDG), shown at /impressum and linked in the footer (no quotes: docker --env-file keeps them)
EFFICHARGE_IMPRINT_NAME=Erika Muster
EFFICHARGE_IMPRINT_ADDRESS=Musterstraße 1, 12345 Berlin
EFFICHARGE_IMPRINT_EMAIL=kontakt@example.org
# where users write when something doesn't work, shown with "use at your own risk"
# (empty: the imprint email)
EFFICHARGE_SUPPORT_EMAIL=help@example.org
# Optional: "Buy me a coffee" link in the footer and on the start page,
# e.g. https://buymeacoffee.com/yourname (empty: no link)
EFFICHARGE_COFFEE_URL=
# AGPL: link to the source code you run (your fork, if you changed it)
EFFICHARGE_SOURCE_URL=https://github.com/AndreasGerken/efficharge
# at launch: let search engines index the site
EFFICHARGE_ALLOW_INDEXING=0
# Privacy notice: who runs the server on your behalf (empty: nobody) and how long backups live
EFFICHARGE_HOSTING_PROVIDER=Example Hosting GmbH, Musterweg 2, 12345 Musterstadt, Germany
EFFICHARGE_BACKUP_DAYS=30
